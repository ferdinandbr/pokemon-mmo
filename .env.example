# URL de conexão com o PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pokemmo?schema=public"

# Chave secreta de autenticação JWT
JWT_SECRET="pokemmo_ultra_secure_jwt_token_key_fire_red_2026"

# Portas dos serviços (opcional)
SERVER_PORT=3000
CLIENT_PORT=80
