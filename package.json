{
  "name": "pokemmo-monorepo",
  "version": "1.0.0",
  "description": "Pokemon Fire Red MMO - Node.js + Prisma + Socket.IO + Phaser 3",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "server:start": "npm --prefix server start",
    "prisma:studio": "npm --prefix server run prisma:studio",
    "test:api": "node server/test-api.js",
    "test:multiplayer": "node server/test-multiplayer.js",
    "maps:tilesets": "node scripts/download_kanto_assets.js --tilesets",
    "maps:convert": "node scripts/convert_tmx_to_json.js",
    "maps:download-all": "node scripts/download_kanto_assets.js --all"
  },
  "devDependencies": {
    "canvas": "^3.2.3"
  }
}
