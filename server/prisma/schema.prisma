generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  name       String
  password   String
  role       String      @default("user") // "user" or "admin"
  createdAt  DateTime    @default(now())
  characters Character[]
}

model Character {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @unique
  gender    String   @default("male") // "male" or "female"
  sprite    String   @default("boy_run") // "boy_run" or "girl_run"
  roomId    String   @default("pallet_town")
  x         Float    @default(320)
  y         Float    @default(320)
  direction String   @default("down") // "down", "left", "right", "up"
  money     Int      @default(5000)
  bagCapacity Int    @default(24)
  equipment String?  @default("{}")
  hasCompletedIntro Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory InventorySlot[]
  pokedex   PokedexEntry[]
  pokemon   Pokemon[]
}

model Item {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  category    String          // "pokeball", "medicine", "battle", "key_item"
  description String
  price       Int             @default(100)
  sprite      String?
  slots       InventorySlot[]
}

model InventorySlot {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      Int
  item        Item      @relation(fields: [itemId], references: [id])
  quantity    Int       @default(1)
  slotIndex   Int

  @@unique([characterId, slotIndex])
}

model PokedexEntry {
  id            Int       @id @default(autoincrement())
  characterId   Int
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  pokemonNumber Int
  pokemonName   String
  status        String    @default("seen") // "seen" or "caught"
  caughtAt      DateTime?

  @@unique([characterId, pokemonNumber])
}

model PokemonSpecies {
  id           Int       @id // Pokedex Number (1 to 151)
  name         String
  internalName String
  type1        String
  type2        String?
  baseHp       Int
  baseAttack   Int
  baseDefense  Int
  baseSpAtk    Int
  baseSpDef    Int
  baseSpeed    Int
  genderRate   String    @default("Genderless")
  growthRate   String    @default("MediumFast")
  baseExp      Int       @default(64)
  evolutions   String    @default("[]") // JSON string of evolution rules
  moves        String    @default("[]") // JSON string of learnset [{level, moveInternalName}]
  instances    Pokemon[]
}

model MoveData {
  id           Int     @id @default(autoincrement())
  name         String
  internalName String  @unique
  type         String
  category     String  @default("Physical") // Physical, Special, Status
  power        Int     @default(0)
  accuracy     Int     @default(100)
  pp           Int     @default(35)
  description  String? @default("")
}

model Pokemon {
  id          Int            @id @default(autoincrement())
  characterId Int
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  speciesId   Int
  species     PokemonSpecies @relation(fields: [speciesId], references: [id])
  nickname    String?
  level       Int            @default(5)
  exp         Int            @default(0)
  gender      String         @default("M") // "M", "F", "G"
  isShiny     Boolean        @default(false)
  currentHp   Int            @default(20)
  maxHp       Int            @default(20)

  // Individual Values (0 to 31)
  ivHp        Int            @default(15)
  ivAtk       Int            @default(15)
  ivDef       Int            @default(15)
  ivSpAtk     Int            @default(15)
  ivSpDef     Int            @default(15)
  ivSpeed     Int            @default(15)

  // Effort Values (0 to 252)
  evHp        Int            @default(0)
  evAtk       Int            @default(0)
  evDef       Int            @default(0)
  evSpAtk     Int            @default(0)
  evSpDef     Int            @default(0)
  evSpeed     Int            @default(0)

  // Calculated Stats JSON { hp, attack, defense, spAtk, spDef, speed }
  stats       String         @default("{}")

  // Active Moves JSON array [{ id, name, type, category, power, pp, maxPp }]
  moves       String         @default("[]")

  // Storage & Party Management
  location    String         @default("party") // "party" or "storage"
  partySlot   Int?           @default(0)       // 0 to 5 for party
  boxNumber   Int            @default(1)       // PC Box 1 to 10
  boxSlot     Int            @default(0)       // Slot 0 to 29 in box
  isBuddy     Boolean        @default(false)   // Active follower buddy

  createdAt   DateTime       @default(now())
}

